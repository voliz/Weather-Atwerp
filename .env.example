# Kaggle API Credentials
# Get your credentials at: https://www.kaggle.com/settings
# Click "Create New API Token" to download kaggle.json

KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_key

# Apache Airflow Configuration
# On Linux/Mac: Use your user ID (run: id -u)
# On Windows: Use 50000 (default)
AIRFLOW_UID=50000

# Optional: Path to kaggle config directory (default: ./kaggle)
# KAGGLE_CONFIG_DIR=C:/Users/YourName/.kaggle
